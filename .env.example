# Prostředí — vyplň lokálně (.env), nikdy necommituj skutečné hodnoty
DATABASE_URL=postgres://user:heslo@localhost:5432/turistickechaty
PAYLOAD_SECRET=
NEXT_PUBLIC_MAPY_API_KEY=

# Redakční prostředí v adminu (/admin/fronta, /admin/vyber-fotek) zapisuje
# rozhodnutí do YAML v repozitáři — tedy jen tam, kde je pracovní kopie.
# Ve vývoji je zápis zapnutý sám; v produkci se musí povolit vědomě
# (a nemá to smysl, dokud web neběží nad pracovní kopií repa).
REDAKCE_ZAPIS=1
