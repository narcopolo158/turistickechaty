# Prostředí — vyplň lokálně (.env), nikdy necommituj skutečné hodnoty
DATABASE_URL=postgres://user:heslo@localhost:5432/turistickechaty
PAYLOAD_SECRET=
NEXT_PUBLIC_MAPY_API_KEY=

# ── Redakční prostředí v adminu (/admin/fronta, /admin/vyber-fotek) ────────
# Rozhodnutí (vybraná fotka, odložený či vyřazený kandidát) patří do YAML
# v repozitáři, protože ten je zdrojem pravdy. Zápis má dva režimy:
#
# 1) NASAZENÝ WEB — commit přes GitHub API. Kontejner nemá pracovní kopii, tak
#    rozhodnutí jde rovnou do repa a projeví se po nejbližším nasazení.
#    Token je jemnozrnný PAT s právem `Contents: Read and write` NA TENHLE REPO
#    (nic víc nepotřebuje) a nikdy nesmí do repozitáře — jen do prostředí.
REDAKCE_GITHUB_TOKEN=
REDAKCE_GITHUB_REPO=narcopolo158/turistickechaty
# REDAKCE_GITHUB_BRANCH=main
#
# 2) LOKÁLNĚ (`npm run dev`) — zápis rovnou do pracovní kopie, commit ručně.
#    Ve vývoji je zapnutý sám; `REDAKCE_ZAPIS=0` ho vypne.
REDAKCE_ZAPIS=1
