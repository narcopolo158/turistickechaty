# INFRA-01 · šablona produkčního prostředí — NIKDY do gitu s reálnými
# hodnotami. Spravuje se ve Forge: Site → Settings → Environment
# (žádné SSH; Forge soubor linkuje do každé release, viz deploy log
# „Linking environment file").
# Po změně hodnot: restart aplikace (`pm2 restart site-3312291`, nebo
# prostě další běh deploy workflow — restartuje vždy).

# ── povinné ───────────────────────────────────────────────────────────────
# POZOR: proměnná se jmenuje DATABASE_URL (payload.config.ts). Oddělená databáze a uživatel (plán kap. Infrastruktura); na pticore
# nejdřív ověřit, že Postgres běží — jinak doinstalovat přes Forge recipe.
DATABASE_URL=postgres://turistickechaty:SILNE_HESLO@127.0.0.1:5432/turistickechaty

# vygenerovat: openssl rand -hex 32 (podepisuje Payload session/tokeny)
PAYLOAD_SECRET=DOPLNIT_64_HEX_ZNAKU

# staging: https://dev.turistickechaty.cz · produkce: https://turistickechaty.cz
NEXT_PUBLIC_SERVER_URL=https://dev.turistickechaty.cz

# port Next.js daemonu — MUSÍ sedět s nginx šablonou (hub na pticore už
# nějaké porty drží; 3017 staging / 3016 produkce)
PORT=3017

# ── volitelné / později ──────────────────────────────────────────────────
# Mapy.com klíč pro budoucí mapové widgety na webu (F0-07). Do prohlížeče
# smí jen klíč s doménovým omezením na turistickechaty.cz!
# NEXT_PUBLIC_MAPY_API_KEY=

# Cloudflare R2 pro fotky mimo server (plán: zálohy/media) — až INFRA-02.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
